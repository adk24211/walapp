    <link href="https://adk24211.github.io/walapp/support/health/%EC%A0%80%EC%86%8C%EB%93%9D%EC%B8%B5-%EA%B8%88%EC%97%B0%EC%B9%98%EB%A3%8C-%EC%A7%80%EC%9B%90/" rel="alternate" type="text/html"/>
