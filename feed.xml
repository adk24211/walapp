    <title type="text">초·중·고 교육비 지원</title>
    <link href="https://adk24211.github.io/walapp/support/care/%EC%B4%88-%EC%A4%91-%EA%B3%A0-%EA%B5%90%EC%9C%A1%EB%B9%84-%EC%A7%80%EC%9B%90/" rel="alternate" type="text/html"/>
    <id>https://adk24211.github.io/walapp/support/care/%EC%B4%88-%EC%A4%91-%EA%B3%A0-%EA%B5%90%EC%9C%A1%EB%B9%84-%EC%A7%80%EC%9B%90/</id>
