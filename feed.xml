  <entry>
    <title type="text">전북 미래인재 육성지원</title>
    <link href="https://adk24211.github.io/walapp/support/education/%EC%A0%84%EB%B6%81-%EB%AF%B8%EB%9E%98%EC%9D%B8%EC%9E%AC-%EC%9C%A1%EC%84%B1%EC%A7%80%EC%9B%90/" rel="alternate" type="text/html"/>
