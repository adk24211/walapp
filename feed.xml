    <link href="https://adk24211.github.io/walapp/support/health/%EC%82%B0%EC%9E%AC%EA%B7%BC%EB%A1%9C%EC%9E%90-%EC%BC%80%EC%96%B4%EC%84%BC%ED%84%B0-%EC%A7%80%EC%9B%90/" rel="alternate" type="text/html"/>
