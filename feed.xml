  </entry>
  <entry>
    <title type="text">아동안전지킴이</title>
    <link href="https://adk24211.github.io/walapp/support/jobs/%EC%95%84%EB%8F%99%EC%95%88%EC%A0%84%EC%A7%80%ED%82%B4%EC%9D%B4/" rel="alternate" type="text/html"/>
