    <link href="https://adk24211.github.io/walapp/support/living/%EA%B5%90%ED%86%B5%EC%95%BD%EC%9E%90%EC%9D%B4%EB%8F%99%EC%A7%80%EC%9B%90%EC%84%BC%ED%84%B0-%EB%8F%99%ED%96%89%EC%B2%9C%EC%82%AC/" rel="alternate" type="text/html"/>
