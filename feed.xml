  </entry>
  <entry>
    <title type="text">귀화허가, 국적회복허가 신청 및 국적업무 증명서 발급 수수료 면제 안내</title>
    <link href="https://adk24211.github.io/walapp/support/living/%EA%B7%80%ED%99%94%ED%97%88%EA%B0%80-%EA%B5%AD%EC%A0%81%ED%9A%8C%EB%B3%B5%ED%97%88%EA%B0%80-%EC%8B%A0%EC%B2%AD-%EB%B0%8F-%EA%B5%AD%EC%A0%81%EC%97%85%EB%AC%B4-%EC%A6%9D%EB%AA%85%EC%84%9C-%EB%B0%9C%EA%B8%89-%EC%88%98%EC%88%98%EB%A3%8C-%EB%A9%B4%EC%A0%9C-%EC%95%88%EB%82%B4/" rel="alternate" type="text/html"/>
