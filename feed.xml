  <entry>
    <title type="text">장애인맞춤형사업화지원</title>
    <link href="https://adk24211.github.io/walapp/support/jobs/%EC%9E%A5%EC%95%A0%EC%9D%B8%EB%A7%9E%EC%B6%A4%ED%98%95%EC%82%AC%EC%97%85%ED%99%94%EC%A7%80%EC%9B%90/" rel="alternate" type="text/html"/>
