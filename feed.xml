  <entry>
    <title type="text">화성 into 테크노폴</title>
    <link href="https://adk24211.github.io/walapp/support/education/%ED%99%94%EC%84%B1-into-%ED%85%8C%ED%81%AC%EB%85%B8%ED%8F%B4/" rel="alternate" type="text/html"/>
