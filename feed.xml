    <link href="https://adk24211.github.io/walapp/support/care/%EC%9E%84%EC%82%B0%EB%B6%80-%EC%97%BD%EC%82%B0%EC%A0%9C-%EC%B2%A0%EB%B6%84%EC%A0%9C-%EC%A7%80%EC%9B%90/" rel="alternate" type="text/html"/>
