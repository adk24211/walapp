    <title type="text">국가유공자 등의 국가정원의 관람료 면제</title>
    <link href="https://adk24211.github.io/walapp/support/care/%EA%B5%AD%EA%B0%80%EC%9C%A0%EA%B3%B5%EC%9E%90-%EB%93%B1%EC%9D%98-%EA%B5%AD%EA%B0%80%EC%A0%95%EC%9B%90%EC%9D%98-%EA%B4%80%EB%9E%8C%EB%A3%8C-%EB%A9%B4%EC%A0%9C/" rel="alternate" type="text/html"/>
    <id>https://adk24211.github.io/walapp/support/care/%EA%B5%AD%EA%B0%80%EC%9C%A0%EA%B3%B5%EC%9E%90-%EB%93%B1%EC%9D%98-%EA%B5%AD%EA%B0%80%EC%A0%95%EC%9B%90%EC%9D%98-%EA%B4%80%EB%9E%8C%EB%A3%8C-%EB%A9%B4%EC%A0%9C/</id>
