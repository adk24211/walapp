  <entry>
    <title type="text">전역예정군인 취업컨설팅 서비스</title>
    <link href="https://adk24211.github.io/walapp/support/jobs/%EC%A0%84%EC%97%AD%EC%98%88%EC%A0%95%EA%B5%B0%EC%9D%B8-%EC%B7%A8%EC%97%85%EC%BB%A8%EC%84%A4%ED%8C%85-%EC%84%9C%EB%B9%84%EC%8A%A4/" rel="alternate" type="text/html"/>
