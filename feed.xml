  </entry>
  <entry>
    <title type="text">산재근로자 대체인력지원 사업</title>
    <link href="https://adk24211.github.io/walapp/support/jobs/%EC%82%B0%EC%9E%AC%EA%B7%BC%EB%A1%9C%EC%9E%90-%EB%8C%80%EC%B2%B4%EC%9D%B8%EB%A0%A5%EC%A7%80%EC%9B%90-%EC%82%AC%EC%97%85/" rel="alternate" type="text/html"/>
