  <entry>
    <title type="text">태안군사랑장학회 장학금</title>
    <link href="https://adk24211.github.io/walapp/support/education/%ED%83%9C%EC%95%88%EA%B5%B0%EC%82%AC%EB%9E%91%EC%9E%A5%ED%95%99%ED%9A%8C-%EC%9E%A5%ED%95%99%EA%B8%88/" rel="alternate" type="text/html"/>
