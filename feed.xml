  </entry>
  <entry>
    <title type="text">발명특허 고등학교 운영 지원</title>
    <link href="https://adk24211.github.io/walapp/support/jobs/%EB%B0%9C%EB%AA%85%ED%8A%B9%ED%97%88-%EA%B3%A0%EB%93%B1%ED%95%99%EA%B5%90-%EC%9A%B4%EC%98%81-%EC%A7%80%EC%9B%90/" rel="alternate" type="text/html"/>
