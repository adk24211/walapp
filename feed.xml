    <link href="https://adk24211.github.io/walapp/support/care/%EC%9A%94%EC%96%91%EA%B8%B0%EA%B4%80-%EC%99%B8-%EC%B6%9C%EC%82%B0-%EC%8B%9C-%EC%B6%9C%EC%82%B0%EB%B9%84-%EC%A7%80%EA%B8%89/" rel="alternate" type="text/html"/>
