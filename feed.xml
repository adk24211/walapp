    <link href="https://adk24211.github.io/walapp/support/care/%EC%A3%BC%EA%B0%84%EB%B3%B4%ED%98%B8-%EC%9D%B4%EC%9A%A9%EC%84%9C%EB%B9%84%EC%8A%A4-%EC%9B%90%EC%A3%BC%EB%B3%B4%ED%9B%88%EC%9A%94%EC%96%91%EC%9B%90/" rel="alternate" type="text/html"/>
