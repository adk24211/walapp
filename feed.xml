    <link href="https://adk24211.github.io/walapp/support/care/%EA%B0%80%EC%A0%95%ED%8F%AD%EB%A0%A5-%ED%94%BC%ED%95%B4%EC%9E%90-%EB%B3%B4%ED%98%B8%EC%8B%9C%EC%84%A4-%EC%9A%B4%EC%98%81-%EC%A7%80%EC%9B%90/" rel="alternate" type="text/html"/>
