  <entry>
    <title type="text">의왕시인재육성재단 장학금</title>
    <link href="https://adk24211.github.io/walapp/support/education/%EC%9D%98%EC%99%95%EC%8B%9C%EC%9D%B8%EC%9E%AC%EC%9C%A1%EC%84%B1%EC%9E%AC%EB%8B%A8-%EC%9E%A5%ED%95%99%EA%B8%88/" rel="alternate" type="text/html"/>
