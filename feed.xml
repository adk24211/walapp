  </entry>
  <entry>
    <title type="text">장애 체육인 생활지원금 지원</title>
    <link href="https://adk24211.github.io/walapp/support/living/%EC%9E%A5%EC%95%A0-%EC%B2%B4%EC%9C%A1%EC%9D%B8-%EC%83%9D%ED%99%9C%EC%A7%80%EC%9B%90%EA%B8%88-%EC%A7%80%EC%9B%90/" rel="alternate" type="text/html"/>
