  <entry>
    <title type="text">산단노동자자녀장학금</title>
    <link href="https://adk24211.github.io/walapp/support/education/%EC%82%B0%EB%8B%A8%EB%85%B8%EB%8F%99%EC%9E%90%EC%9E%90%EB%85%80%EC%9E%A5%ED%95%99%EA%B8%88/" rel="alternate" type="text/html"/>
    <id>https://adk24211.github.io/walapp/support/education/%EC%82%B0%EB%8B%A8%EB%85%B8%EB%8F%99%EC%9E%90%EC%9E%90%EB%85%80%EC%9E%A5%ED%95%99%EA%B8%88/</id>
