    <title type="text">청년 창업·취업 학원비 지원</title>
    <link href="https://adk24211.github.io/walapp/support/jobs/%EC%B2%AD%EB%85%84-%EC%B0%BD%EC%97%85-%EC%B7%A8%EC%97%85-%ED%95%99%EC%9B%90%EB%B9%84-%EC%A7%80%EC%9B%90/" rel="alternate" type="text/html"/>
