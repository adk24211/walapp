# 지원금 도감 환경변수 템플릿
# 이 파일을 .env로 복사한 뒤 값을 채워주세요. .env는 절대 커밋하지 마세요.

# 공공데이터포털 API 키 (실 운영 필수)
# https://www.data.go.kr 에서 활용신청 후 발급합니다.
#
# 중앙부처 우선 방침이므로 지금은 아래 둘만 신청하면 됩니다:
#   15113968  행정안전부_대한민국 공공서비스(혜택) 정보 (보조금24)
#   15090532  한국사회보장정보원_중앙부처복지서비스
#
# 지자체까지 범위를 넓힐 때 추가로 신청할 것 (REGION_SCOPE 도 함께 변경):
#   15108347  한국사회보장정보원_지자체복지서비스
#   15143273  한국고용정보원_온통청년_청년정책
#
# 이 키가 없으면 목(mock) 데이터로 동작합니다.
DATA_GO_KR_API_KEY=

# Groq API 키 (선택, 무료 — https://console.groq.com)
# 없으면 원본 필드를 재배치하는 오프라인 해설 생성으로 동작합니다.
GROQ_API_KEY=

# 개발용 옵션
# MOCK_DATA=1          # 1이면 강제 목 모드, 0이면 강제 실 API 모드
# POST_DATE=2026-08-12 # 기준 날짜 override (YYYY-MM-DD)
# REGION_SCOPE=national          # 발행 범위. 지자체 포함은 national,sido,sigungu
# PUBLISH_LIMIT=5      # 하루 신규 발행 상한
# REFRESH_LIMIT=10     # 하루 갱신 상한
# DRY_RUN=1            # 파일 저장 없이 출력만
