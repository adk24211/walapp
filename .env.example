# 데일리브리프 환경변수 템플릿
# 이 파일을 .env로 복사한 뒤 값을 채워주세요
# .env는 .gitignore에 추가해서 절대 커밋하지 마세요

# Gemini API 키 (필수, 무료)
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=AIza...

# 개발용 옵션
# POST_DATE=2026-05-30       # 날짜 override (YYYY-MM-DD)
# SKIP_COLLECT=1             # 수집 스킵, 캐시 데이터 사용
# DRY_RUN=1                  # 파일 저장 없이 출력만
